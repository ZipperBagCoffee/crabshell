{
  "description": "Crabshell Codex-native lifecycle, memory continuity, and deterministic path guard.",
  "hooks": {
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"Promise.resolve().then(() => require(process.env.PLUGIN_ROOT + '/scripts/adapters/codex/pre-compact.js').main()).catch(() => {})\"",
            "commandWindows": "node -e \"Promise.resolve().then(() => require(process.env.PLUGIN_ROOT + '/scripts/adapters/codex/pre-compact.js').main()).catch(() => {})\"",
            "timeout": 10,
            "statusMessage": "Preserving Crabshell compaction context"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"Promise.resolve().then(() => require(process.env.PLUGIN_ROOT + '/scripts/adapters/codex/post-compact.js').main()).catch(() => {})\"",
            "commandWindows": "node -e \"Promise.resolve().then(() => require(process.env.PLUGIN_ROOT + '/scripts/adapters/codex/post-compact.js').main()).catch(() => {})\"",
            "timeout": 10,
            "statusMessage": "Restoring Crabshell compaction state"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"Promise.resolve().then(() => require(process.env.PLUGIN_ROOT + '/scripts/adapters/codex/post-tool-use.js').main({ host: 'codex' })).catch(() => {})\"",
            "commandWindows": "node -e \"Promise.resolve().then(() => require(process.env.PLUGIN_ROOT + '/scripts/adapters/codex/post-tool-use.js').main({ host: 'codex' })).catch(() => {})\"",
            "timeout": 10,
            "statusMessage": "Recording parent verification evidence"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"Promise.resolve().then(() => require(process.env.PLUGIN_ROOT + '/scripts/adapters/codex/subagent-start.js').main()).catch(() => {})\"",
            "commandWindows": "node -e \"Promise.resolve().then(() => require(process.env.PLUGIN_ROOT + '/scripts/adapters/codex/subagent-start.js').main()).catch(() => {})\"",
            "timeout": 10,
            "statusMessage": "Loading Crabshell worker scope"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"Promise.resolve().then(() => require(process.env.PLUGIN_ROOT + '/scripts/adapters/codex/stop.js').main({ host: 'codex' })).catch(() => {})\"",
            "commandWindows": "node -e \"Promise.resolve().then(() => require(process.env.PLUGIN_ROOT + '/scripts/adapters/codex/stop.js').main({ host: 'codex' })).catch(() => {})\"",
            "timeout": 10,
            "statusMessage": "Recording Crabshell child completion claim"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"Promise.resolve().then(() => require(process.env.PLUGIN_ROOT + '/scripts/adapters/codex/user-prompt-submit.js').main()).catch(() => {})\"",
            "commandWindows": "node -e \"Promise.resolve().then(() => require(process.env.PLUGIN_ROOT + '/scripts/adapters/codex/user-prompt-submit.js').main()).catch(() => {})\"",
            "timeout": 10,
            "statusMessage": "Loading Crabshell turn contract"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"Promise.resolve().then(() => require(process.env.PLUGIN_ROOT + '/scripts/adapters/codex/session-start.js').main()).catch(() => {})\"",
            "commandWindows": "node -e \"Promise.resolve().then(() => require(process.env.PLUGIN_ROOT + '/scripts/adapters/codex/session-start.js').main()).catch(() => {})\"",
            "timeout": 10,
            "statusMessage": "Loading Crabshell project memory"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"Promise.resolve().then(() => require(process.env.PLUGIN_ROOT + '/scripts/adapters/codex/stop.js').main({ host: 'codex' })).catch(() => {})\"",
            "commandWindows": "node -e \"Promise.resolve().then(() => require(process.env.PLUGIN_ROOT + '/scripts/adapters/codex/stop.js').main({ host: 'codex' })).catch(() => {})\"",
            "timeout": 10,
            "statusMessage": "Checking Crabshell completion evidence"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|Read|Grep|Glob|Write|Edit)$",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"Promise.resolve().then(() => require(process.env.PLUGIN_ROOT + '/scripts/adapters/codex/pre-tool-use.js').main()).catch(() => {})\"",
            "commandWindows": "node -e \"Promise.resolve().then(() => require(process.env.PLUGIN_ROOT + '/scripts/adapters/codex/pre-tool-use.js').main()).catch(() => {})\"",
            "timeout": 10,
            "statusMessage": "Checking Crabshell memory paths"
          }
        ]
      }
    ]
  }
}
